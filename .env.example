# Copy to .local/.env for Docker, or to .env for local Python.
# Telegram bot token from BotFather.
TELEGRAM_BOT_TOKEN=
# Official separate Telegram test server; requires a bot token from its own BotFather.
# Only permitted with APP_ENV=local. Production remains the default.
TELEGRAM_TEST_ENVIRONMENT=false

# Local uses SQLite by default; production requires PostgreSQL.
APP_ENV=local
# Optional URL: sqlite+aiosqlite:////path/db.sqlite3 or postgresql+asyncpg://...
DATABASE_URL=
# Automatically generated and saved on first bot startup. Keep it private and stable.
BOT_VERIFICATION_SECRET=
# Organizer Mini App. Leave URL empty to run only the Telegram bot.
# HTTPS origin without a path. Can be a local address with a trusted development certificate.
# HTTP is supported only when TELEGRAM_TEST_ENVIRONMENT=true.
MINI_APP_URL=
MINI_APP_HOST=127.0.0.1
MINI_APP_PORT=8080
# Optional direct HTTPS instead of a reverse proxy. Set both paths or leave both empty.
# Relative paths resolve from this .env file's directory; keep private keys under .local/.
MINI_APP_TLS_CERT_FILE=
MINI_APP_TLS_KEY_FILE=
# Used by the production Compose stack when DATABASE_URL is empty.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=registrar
POSTGRES_USER=registrar
POSTGRES_PASSWORD=

# Your own Microsoft Entra public-client application (no client secret).
GRAPH_CLIENT_ID=
# Tenant ID from the application overview, or organizations.
GRAPH_TENANT_ID=organizations
# Optional: restrict sign-in to this account's userPrincipalName.
GRAPH_ACCOUNT=
# Optional: defaults to the signed-in account's UPN domain.
GRAPH_STUDENT_DOMAIN=
GRAPH_TIMEOUT_SECONDS=15
GRAPH_CACHE_TTL_SECONDS=300
GRAPH_DEBUG=false
# Automatically saved MSAL cache. Contains refresh tokens; keep private.
GRAPH_TOKEN_CACHE_B64=
