# Copy to .local/.env for Docker, or to .env for local Python.
# Telegram bot token from BotFather. The bot is public and only looks up profiles.
TELEGRAM_BOT_TOKEN=

# Your own Microsoft Entra public-client application (no client secret).
GRAPH_CLIENT_ID=
# Tenant ID from the application overview, or organizations.
GRAPH_TENANT_ID=organizations
# Optional: restrict sign-in to this account's userPrincipalName.
GRAPH_ACCOUNT=
# Optional: defaults to the signed-in account's UPN domain.
GRAPH_STUDENT_DOMAIN=
GRAPH_TIMEOUT_SECONDS=15
GRAPH_CACHE_TTL_SECONDS=300
GRAPH_DEBUG=false
# Automatically saved MSAL cache. Contains refresh tokens; keep private.
GRAPH_TOKEN_CACHE_B64=
