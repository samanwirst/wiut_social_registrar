{
	admin off
	auto_https disable_redirects
}

https://{$REGISTRAR_PUBLIC_IP}:443 {
	tls {
		issuer acme {
			dir {$REGISTRAR_ACME_CA:https://acme-v02.api.letsencrypt.org/directory}
			profile shortlived
            disable_http_challenge
		}
	}
	reverse_proxy bot:8080
	header Strict-Transport-Security "max-age=31536000"
}
